DATABASE_URL="file:./dev.db"
AUTH_SECRET="mediflow-demo-secret-change-me-32ch"
# Optional. If set, POST /api/staging/reset with Bearer token re-seeds demo data.
# Leave empty to disable the endpoint. Never commit a production secret.
STAGING_RESET_TOKEN=""
# Used by `npm run staging:start`: if-empty | always | never
SEED_ON_START="if-empty"
# Optional. Override Set-Cookie Secure. Unset = true when NODE_ENV=production.
# Playwright sets COOKIE_SECURE=false so the session works on local HTTP.
COOKIE_SECURE=""
